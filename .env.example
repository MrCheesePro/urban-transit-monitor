DATABASE_URL=postgresql+psycopg://transit:transit@localhost:5434/transit

# Production only (docker-compose.prod.yml): a long random database password, set before the first
# start. Generate one with: openssl rand -hex 24
# POSTGRES_PASSWORD=

ENABLED_REGIONS=["boston","los-angeles","orange-county"]

# Los Angeles (LA Metro). Timetables are open. Live feeds need an API key from
# https://developer.metro.net. Put your key after the = in your own .env (never commit it).
# Without a key, Los Angeles shows timetables only and its live jobs do not run.
LA_METRO_API_KEY=
LA_METRO_API_KEY_HEADER=Authorization
LA_METRO_BUS_STATIC_GTFS_URL=https://gitlab.com/LACMTA/gtfs_bus/-/raw/master/gtfs_bus.zip
LA_METRO_BUS_VEHICLE_POSITIONS_URL=https://api.goswift.ly/real-time/lametro/gtfs-rt-vehicle-positions
LA_METRO_BUS_TRIP_UPDATES_URL=https://api.goswift.ly/real-time/lametro/gtfs-rt-trip-updates
LA_METRO_RAIL_STATIC_GTFS_URL=https://gitlab.com/LACMTA/gtfs_rail/-/raw/master/gtfs_rail.zip
LA_METRO_RAIL_VEHICLE_POSITIONS_URL=https://api.goswift.ly/real-time/lametro-rail/gtfs-rt-vehicle-positions
LA_METRO_RAIL_TRIP_UPDATES_URL=https://api.goswift.ly/real-time/lametro-rail/gtfs-rt-trip-updates

# The other Los Angeles operators. Open feeds, no key needed.
LADOT_STATIC_GTFS_URL=https://ladotbus.com/gtfs
LADOT_VEHICLE_POSITIONS_URL=https://ladotbus.com/gtfs-rt/vehiclepositions
LADOT_TRIP_UPDATES_URL=https://ladotbus.com/gtfs-rt/tripupdates
LONG_BEACH_STATIC_GTFS_URL=https://rapid.nationalrtap.org/GTFSFileManagement/UserUploadFiles/14866/google_transit.zip
LONG_BEACH_VEHICLE_POSITIONS_URL=https://gtfs-rt.lbt.vontascloud.com/TMGTFSRealTimeWebService/Vehicle/VehiclePositions.pb
LONG_BEACH_TRIP_UPDATES_URL=https://gtfs-rt.lbt.vontascloud.com/TMGTFSRealTimeWebService/TripUpdate/TripUpdates.pb

# Orange County (OCTA). Open feeds, no key needed.
OCTA_STATIC_GTFS_URL=https://www.octa.net/current/google_transit.zip
OCTA_VEHICLE_POSITIONS_URL=https://api.octa.net/GTFSRealTime/protoBuf/VehiclePositions.aspx
OCTA_TRIP_UPDATES_URL=https://api.octa.net/GTFSRealTime/protoBuf/tripupdates.aspx

# Boston (MBTA). Open feeds, no key needed.
MBTA_VEHICLE_POSITIONS_URL=https://cdn.mbta.com/realtime/VehiclePositions.pb
MBTA_TRIP_UPDATES_URL=https://cdn.mbta.com/realtime/TripUpdates.pb
MBTA_STATIC_GTFS_URL=https://cdn.mbta.com/MBTA_GTFS.zip
HTTP_TIMEOUT_SECONDS=60
REALTIME_HTTP_TIMEOUT_SECONDS=15

POLL_INTERVAL_SECONDS=60
ON_TIME_EARLY_SECONDS=-60
ON_TIME_LATE_SECONDS=300
SEVERITY_MAJOR_SECONDS=600
SEVERITY_SEVERE_SECONDS=1200
LIVE_VEHICLE_MAX_AGE_SECONDS=300
FEED_STALE_AFTER_SECONDS=180
STOP_EVENTS_INTERVAL_SECONDS=300
STOP_EVENTS_ACTIVE_WINDOW_MINUTES=15
STOP_EVENTS_HISTORY_HOURS=4
STOP_EVENT_MAX_GAP_SECONDS=600
AGGREGATE_LOOKBACK_HOURS=3
HISTORICAL_DEFAULT_DAYS=30
FREQUENT_HEADWAY_SECONDS=900
RETENTION_DAYS=14
PARTITION_DAYS_AHEAD=3
STOP_EVENTS_RETENTION_DAYS=90
HOURLY_PERFORMANCE_RETENTION_DAYS=400
INGEST_RUNS_RETENTION_DAYS=30
VEHICLE_LATEST_RETENTION_HOURS=24
RETENTION_BATCH_SIZE=10000
RANKING_MIN_SAMPLES=200
TIMEZONE=America/New_York
